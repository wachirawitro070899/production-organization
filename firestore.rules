rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /examAssignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /onlineExamRecords/{recordId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /skillHistory/{historyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /skillAssessments/{assessmentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
